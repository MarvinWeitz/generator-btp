{
  "name": "<%= customerName %> - <%= projectName %>",
  "image": "<%= baseImage %>",
  "runArgs": [
    "--name=<%= customerNameNormalized %>.<%= projectNameNormalized %>"
  ],
  "features": {
    "ghcr.io/devcontainers/features/node:2": {},
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "extensions": "azure-devops"
    },
    "ghcr.io/cbs-consulting/container-features/btp-cli-tools:1": {},
    "ghcr.io/cbs-consulting/container-features/cap-dev-stack:1": {},
    "ghcr.io/cbs-consulting/container-features/fiori-dev-stack:1": {},
    "ghcr.io/cbs-consulting/container-features/dev-defaults:1": {},
    "ghcr.io/cbs-consulting/container-features/typescript:1": {}<% if (npmFeedsString) { %>,
      // Private npm feeds - PAT is prompted interactively at post-create time
      "ghcr.io/cbs-consulting/container-features/npm-feeds:1": {
        "feeds": <%- JSON.stringify(npmFeedsString) %>
      }<%
    } %>
  },
  "customizations": {
    "vscode": {
      // MCP server configurations
      "mcp": {
        "servers": {
          "cds-mcp": {
            "command": "npx",
            "args": [
              "-y",
              "@cap-js/mcp-server"
            ],
            "env": {},
            "type": "stdio"
          },
          "ui5-mcp": {
            "command": "npx",
            "args": [
              "-y",
              "@ui5/mcp-server"
            ],
            "env": {},
            "type": "stdio"
          },
          "fiori-mcp": {
            "command": "npx",
            "args": [
              "-y",
              "@sap-ux/fiori-mcp-server@latest",
              "fiori-mcp"
            ],
            "env": {},
            "type": "stdio"
          }
        }
      }
    }
  }
}